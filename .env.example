# Copy this file to `.env` (which is git-ignored) and fill in real values.
# `.env` is only read on the machine actually running the app (the robot),
# and never leaves it. Nothing here is required: if `.env` is missing, or
# OTEL_EXPORTER_OTLP_ENDPOINT is unset, the app runs exactly as it does
# today with no remote logging.

# --- Remote log streaming (optional) -----------------------------------
# Ships this app's logs over OpenTelemetry (OTLP/HTTP) so you can
# tail/search them from a browser on your laptop instead of SSH-ing into
# the robot. Works with any OTLP-compatible backend; Grafana Cloud has a
# generous free tier.
#
# Setup:
#   1. Create a free account at https://grafana.com/auth/sign-up/create-user
#   2. In your Grafana Cloud stack, open Connections -> Add new connection
#      -> OpenTelemetry (OTLP), and copy the two `export OTEL_EXPORTER_...`
#      lines it generates for you.
#   3. Paste them below exactly as given - the app reads these standard
#      OTel env var names directly, no reformatting needed.
export OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-xx-xxxx-x.grafana.net/otlp"
export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<base64-of-instanceid:api-key>"

# Optional: override the "service.instance.id" label used to tell multiple
# robots apart in your dashboard. Defaults to a stable name derived from
# the robot's machine ID.
# REACHY_LOG_HOST_LABEL=reachy-mini-desk
